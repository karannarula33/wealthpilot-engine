# ============================================
# WealthPilot — Environment Configuration
# Copy this to .env and fill in your values
# ============================================

# --- Zerodha Kite Connect ---
# Sign up at https://developers.kite.trade
# Personal plan: Free (orders/portfolio only)
# Paid plan: ₹500/month (adds live data + historical)
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here
ZERODHA_USER_ID=your_zerodha_client_id

# --- Anthropic (Claude AI) ---
# Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Twilio (WhatsApp) ---
# Sign up at https://www.twilio.com
# Start with sandbox for testing, then get a production number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# --- Supabase (Database) ---
# Create project at https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# --- Redis (Job Queue) ---
# Free tier at https://upstash.com
REDIS_URL=rediss://default:password@your-redis.upstash.io:6379

# --- App Configuration ---
NODE_ENV=development
PORT=3000
TIMEZONE=Asia/Kolkata

# --- User Phone Numbers (E.164 format) ---
KARAN_PHONE=+91XXXXXXXXXX
SHUBHANGI_PHONE=+91XXXXXXXXXX

# --- Webhook URL (for Twilio inbound messages) ---
# Set this to your deployed backend URL + /api/webhook/whatsapp
# For local dev, use ngrok: https://your-tunnel.ngrok.io/api/webhook/whatsapp
WEBHOOK_BASE_URL=https://your-app.railway.app
